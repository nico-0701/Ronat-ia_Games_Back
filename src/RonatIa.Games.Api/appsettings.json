{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Client": {
    "MinClientVersion": "0.0.0"
  },
  "Auth": {
    "DefaultRegion": "BR",
    "TermsVersion": "2026-10"
  },
  "Registration": {
    "Mode": "Open"
  },
  "RateLimiting": {
    "Enabled": true
  },
  "Docs": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowedOriginPatterns": []
  }
}
