# Copie para `.env` (que é ignorado pelo Git) ou configure as variáveis no provedor (Render, GitHub Actions).
# NUNCA coloque valores reais neste arquivo. Em desenvolvimento local prefira `dotnet user-secrets` (ver README).
# No ASP.NET Core, "__" nas variáveis de ambiente equivale a ":" na configuração.

# --- Banco de dados (PostgreSQL / Supabase) ---
# Use o POOLER do Supabase (modo session, porta 5432). A conexão direta (db.<ref>.supabase.co) é só IPv6
# e não funciona no Render nem no GitHub Actions.
ConnectionStrings__Default=Host=aws-0-<REGIAO>.pooler.supabase.com;Port=5432;Database=postgres;Username=<ROLE>.<PROJECT_REF>;Password=<SENHA>;SSL Mode=Require;Trust Server Certificate=true;Maximum Pool Size=10

# --- Autenticação ---
# Chave de assinatura do JWT (>= 32 bytes aleatórios em base64). Gere com: openssl rand -base64 64
Jwt__SigningKey=<CHAVE_BASE64>
# Opcional: chave anterior, aceita apenas para validar tokens ainda válidos durante uma rotação.
Jwt__PreviousSigningKey=
# Segredo (pepper) do HMAC do telefone (>= 32 bytes em base64). NUNCA troque depois de haver usuários:
# trocar invalida todos os logins. Guarde uma cópia em gerenciador de senhas.
Auth__PhonePepper=<PEPPER_BASE64>

# --- Cadastro ---
# open = cadastro livre | closed = bloqueia novos cadastros (válvula de escape contra abuso)
Registration__Mode=open

# --- Anti-bot (Cloudflare Turnstile). Se vazio, a verificação fica desligada ---
Turnstile__SecretKey=

# --- CORS: origens permitidas do front (Pages, localhost, Capacitor) ---
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=https://localhost
# Padrões (regex) para previews do Cloudflare Pages deste projeto
Cors__AllowedOriginPatterns__0=^https://[a-z0-9-]+\.ronat-ia-games\.pages\.dev$

# --- Porta (o Render define PORT automaticamente) ---
# PORT=10000
